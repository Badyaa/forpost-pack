                "id": "structurize:sceptergold",
                "Count": 1
              },
              "precision": "FUZZY"
            }
          ],
          "description": {
            "text": "Строительный инструмент",
            "isTranslationKey": false
          },
          "longDescription": {
            "text": "Кликните ПКМ инструментом по земле: откроется меню чертежей. Слева выберите набор стиля (для начала подойдёт «Medieval Oak» или любой другой), справа — здание и уровень. Клавиши: R — повернуть, M — отразить, стрелки — сдвинуть. Зелёный контур — можно ставить, красный — мешают блоки или граница колонии. Подтвердите — на месте появится ограждающая лента и «заявка на стройку».",
            "isTranslationKey": false
          }
        }
      ],
